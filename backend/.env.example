# QUANTARA local environment template
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Persistence
MONGODB_URI=

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=128h

# AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=

# Routing / traffic / geocoding
TOMTOM_API_KEY=
TOMTOM_BASE_URL=https://api.tomtom.com
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Voice
STT_PROVIDER=browser
TTS_PROVIDER=browser
CHATTERBOX_TTS_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ASSEMBLYAI_API_KEY=

# Email OTP (optional)
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=

MAP_PROVIDER=osm
ROUTING_PROVIDER=tomtom
ROUTING_FALLBACK=osrm
TRAFFIC_PROVIDER=tomtom
TRAFFIC_FALLBACK=simulation
WEATHER_PROVIDER=open-meteo
GEOCODING_PROVIDER=tomtom
GEOCODING_FALLBACK=nominatim

# Digital twin / determinism
# Seeds the ambient traffic drift so a demo run is reproducible.
TWIN_SEED=26137
# Set to false to freeze background traffic drift (useful for deterministic demos/tests).
TWIN_BACKGROUND_DRIFT=true
# Set to true to skip all live TomTom/OSRM geometry snapping; routes use internal-graph
# geometry only (reported as FALLBACK). Useful offline or in CI.
ROUTING_OFFLINE=false
